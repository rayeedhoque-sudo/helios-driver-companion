{
  "name": "helios-driver-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Helios Driver Companion \u2014 single-window driver dashboard for FRC Team 9704.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "check": "node -e \"require('esbuild').buildSync({entryPoints:['tools/tuning-check.ts'],bundle:true,platform:'node',outfile:'dist/tuning-check.cjs'})\" && node dist/tuning-check.cjs"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@msgpack/msgpack": "^3.1.3",
    "dockview-core": "^7.0.2",
    "koffi": "^3.1.1",
    "uplot": "^1.6.32"
  }
}
